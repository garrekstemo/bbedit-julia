	<key>Language Features</key>
	<dict>
		<!-- @ and ! are included so macros (@time) and mutating
		     functions (push!) are single words. -->
		<key>Identifier and Keyword Character Class</key>
		<string>A-Za-z0-9_!@</string>

		<!-- Nested #= =# block comments, then # line comments. -->
		<key>Comment Pattern</key>
		<string><![CDATA[
		(?x:
			(?P<blockcomment> \#= (?: [^=\#]++ | =(?!\#) | \#(?!=) | (?P>blockcomment) )* =\# )
			|
			\#[^\r\n]*
		)
		]]></string>

		<!--
			Triple-quoted and ordinary strings with any prefix (r"", raw"",
			b"", L"", ...), commands in backticks, and character literals.
			$( ) interpolation may contain its own quoted strings. A quote
			right after a name or closing bracket is the adjoint operator
			(A'), not a character literal.
		-->
		<key>String Pattern</key>
		<string><![CDATA[
		(?x:
			(?: (?<![\w!]) [A-Za-z_]\w* )?
			(?:
				"""  (?: \\. | (?P>interp) | "(?!"") | [^"\\$]++ | \$ )*  """
				|
				(?P<dqstring> " (?: \\. | (?P<interp> \$\( (?: [^()"]++ | (?P>dqstring) | (?P<parens> \( (?: [^()"]++ | (?P>dqstring) | (?P>parens) )* \) ) )* \) ) | [^"\\$]++ | \$ )* " )
				|
				```  (?: \\. | `(?!``) | [^`\\]++ )*  ```
				|
				`  (?: \\. | [^`\\\r\n]++ )*  `
			)
			|
			(?<! [\w!)\]}'.] ) ' (?: \\[^'\r\n]{1,10}+ | [^\\'\r\n] ) '
		)
		]]></string>

		<!--
			Definitions must start a line; (?<![^\r\n]) is used rather than ^
			so this holds whatever newline convention the regex engine uses.
			Long-form definitions (function, macro, struct, mutable struct)
			end at an "end" with the same indentation; one-line forms
			(function f end) end on their own line. Short-form definitions
			look like  f(x) = ...  at the start of a line. Leading macros
			such as @inline or Base.@kwdef are allowed.
		-->
		<key>Function Pattern</key>
		<string><![CDATA[
		(?x:
			(?<! [^\r\n] ) (?P<leadspace> [ \t]* )
			(?P<function>
				(?: [\w.]*@[\w.]+ [ \t]+ )*
				(?: (?P<kw> function | macro | (?:mutable [ \t]+)? struct ) [ \t]+ )?
				(?P<function_name>
					(?: (?:[A-Za-z_]|[^\x00-\x7F]) (?:[\w!]|[^\x00-\x7F])* \. )*
					(?: (?:[A-Za-z_]|[^\x00-\x7F]) (?:[\w!]|[^\x00-\x7F])* | : [^\s\w(){}\[\],;]+ )
				)
				(?(<kw>)
					(?:
						[^\r\n]*? \bend\b [ \t;]* (?=[\r\n]|\z)
						|
						(?s:.*?) [\r\n] (?P=leadspace) end\b
					)
					|
					(?: \{ [^}\r\n]* \} )?
					(?P<signature> \( (?: [^()\r\n]++ | (?P>signature) )* \) )
					[^=\r\n]*? (?<! [=!<>.+\-*/^%&|\\~$:÷] ) = (?! [=>] )
					[^\r\n]*
				)
			)
		)
		]]></string>

		<key>Skip Pattern</key>
		<string><![CDATA[
		(?x:
			(?P>comment) |
			(?P>string)
		)
		]]></string>
	</dict>
